# =====================================================
# NovaPOS - Variables de Entorno
# =====================================================
# IMPORTANTE: Este archivo NO debe subirse a git.
# Copia este archivo como .env y rellena los valores reales.
# =====================================================

# URL del Web App de Google Apps Script
# Pasos: Apps Script -> Implementar -> Nueva implementación -> Web App -> Acceso: Cualquiera
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxPKIbrapPUFSwHXMbbI-pj4dPy6D03DvFI9u54ESfovQKLgJkvI19kqS73PXFV93mB/exec

# Token secreto para autenticar peticiones al backend
# Debe coincidir con el valor guardado en Apps Script Properties con la clave 'API_TOKEN'
# Genera uno seguro en: https://generate-secret.vercel.app/32
VITE_API_TOKEN=CAMBIA_ESTO_POR_UN_TOKEN_SECRETO_SEGURO
