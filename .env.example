# =====================================================
# NovaPOS - Plantilla de Variables de Entorno
# =====================================================
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO debe subirse a git (está en .gitignore).
# =====================================================

# URL del Web App de Google Apps Script
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/TU_URL_AQUI/exec

# Token secreto para autenticar peticiones al backend
# Debe coincidir con el valor en Apps Script > Properties > 'API_TOKEN'
VITE_API_TOKEN=TU_TOKEN_SECRETO_AQUI
